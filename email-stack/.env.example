# OreWire email stack — copy to .env / Dokploy environment and fill in

# Base domain for the stack. Add ONE wildcard DNS record: *.EMAIL_DOMAIN -> VPS IP
# Gives you: console.EMAIL_DOMAIN, lists.EMAIL_DOMAIN, postal.EMAIL_DOMAIN
EMAIL_DOMAIN=email.orewirehq.co

# Postal infra hostname (used for HELO/return-path links; A record -> VPS IP)
POSTAL_HOST_DOMAIN=postal.email.orewirehq.co

# Postal database
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# Listmonk
LISTMONK_DB_PASSWORD=
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
