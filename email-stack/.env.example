# OreWire email stack — copy to .env / Dokploy environment and fill in

# Base domain for the stack. Add ONE wildcard DNS record: *.emails.orewire.com -> VPS IP
# Gives you: emails.orewire.com (Console), lists.emails.orewire.com (Listmonk),
#            postal.emails.orewire.com (Postal)
# IMPORTANT: if orewire.com is on Cloudflare, set this record to "DNS only" (grey cloud) —
# the proxy breaks Traefik's TLS and Let's Encrypt HTTP-01 challenge.
EMAIL_DOMAIN=emails.orewire.com

# Postal infra hostname (HELO / return-path infrastructure; A record -> VPS IP).
# NOTE: this ties the mail server's infrastructure identity to orewire.com. Fine to start;
# if you prefer full isolation later, move this to an outreach domain and update DNS.
POSTAL_HOST_DOMAIN=postal.emails.orewire.com

# Postal database
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# Listmonk
LISTMONK_DB_PASSWORD=
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
