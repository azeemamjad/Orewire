# OreWire email stack — copy to .env and fill in before docker compose up / Dokploy deploy

# Postal host domain (A record -> your VPS IP), e.g. postal.orewirehq.co
POSTAL_HOST_DOMAIN=

# Host ports for the UIs
POSTAL_WEB_PORT=5000
LISTMONK_PORT=9000
CONSOLE_PORT=8018

# Postal database
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# Listmonk
LISTMONK_DB_PASSWORD=
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
