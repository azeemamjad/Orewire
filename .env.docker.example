# Optional overrides for docker compose (copy to .env in repo root)
SERVER_PORT=8070
FRONTEND_PORT=8080

# Baked into frontend image at build time — must be reachable from the user's browser
VITE_API_URL=http://localhost:8070/api
VITE_FRONTEND_DOMAIN=localhost:8080
VITE_BACKEND_DOMAIN=localhost:8070

# Dokploy production build args (set in Dokploy UI, not compose):
# VITE_API_URL=https://backend.orewire.com/api
# VITE_FRONTEND_DOMAIN=orewire.com
# VITE_BACKEND_DOMAIN=backend.orewire.com

# ---------------------------------------------------------------------------
# SEO / AEO / GEO
#
# These are the difference between the crawler rendering working and the site
# staying invisible to search and answer engines. Full reasoning and the
# verification steps: docs/seo-aeo-geo-playbook.md
# ---------------------------------------------------------------------------

# FRONTEND service. Where nginx sends crawler requests and the generated
# sitemaps. If this is wrong or unreachable, /sitemap.xml, /llms.txt and every
# crawler-rendered company page fail while the site still looks fine in a
# browser. The Dockerfile default is the public backend host; a private service
# URL is faster because it skips a round trip back out through Cloudflare.
BACKEND_UPSTREAM=http://backend.orewire.com

# FRONTEND service, optional. An nginx map mask, including its own operator, for
# a crawler that is not already in the frontend nginx.conf list. A newly launched
# AI crawler that is missing from that list is silently served the empty SPA
# shell, so this exists to fix that with a restart instead of a rebuild.
# Defaults to ~*orewire-never-matches (a valid mask that matches nothing).
#   EXTRA_CRAWLER_UA_PATTERN=~*newai-bot

# BACKEND service. The canonical origin used for <link rel="canonical">, for the
# sitemap and for llms.txt. A request arriving on any other host (the raw
# backend domain, a preview URL) is still served but carries
# X-Robots-Tag: noindex, so only this host is indexed.
SITE_ORIGIN=https://www.orewire.com

# BACKEND service, optional. 8-128 characters of a-z A-Z 0-9 and dashes.
# Enables IndexNow (Bing, Yandex, Seznam and Naver) and serves the key file at
# /<key>.txt, which nginx proxies. Google does not use IndexNow; the point is
# Bing, and therefore Copilot. The key file must resolve BEFORE submitting:
#   curl https://www.orewire.com/<key>.txt
# INDEXNOW_KEY=

# BACKEND service, optional. Daily freshness ping schedule and lookback window.
# Only company profiles whose row changed inside the window are submitted.
# SEO_INDEXNOW_CRON=30 5 * * *
# SEO_INDEXNOW_WINDOW_HOURS=24
