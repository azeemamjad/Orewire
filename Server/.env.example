# Domain Configuration (Production)
FRONTEND_DOMAIN=orewire.com
BACKEND_DOMAIN=backend.orewire.com
# Docker / Dokploy: use 8070 (see Server/Dockerfile). Local node dev may use 3000–3002.
PORT=8070

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Paths — local staging for scraped PDFs (uploaded to S3 when AWS_S3_ENABLED=true)
DOWNLOADS_DIR=./data/downloads
COOKIE_FILE=./data/cookies.json

# Browser scrapers (SEDAR+, ASX, CSE)
HEADLESS=true
MAX_PAGES=50
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Optional override for ASX company-directory CSV (Markit). Default is the public directory/file URL.
# ASX_DIRECTORY_CSV_URL=https://asx.api.markitdigital.com/asx-research/1.0/companies/directory/file?access_token=...
# Force legacy Playwright scrape for ASX filings (usually fails on datacenter proxies).
# ASX_FILINGS_BROWSER=1
# Admin proxy Test button — IP check + optional ASX probe
# RELAY_PROXY_IP_URL=https://api.ipify.org?format=json
# RELAY_PROXY_TEST_URL=https://example.com/
# RELAY_PROXY_PROBE_URL=https://www.asx.com.au/
# RELAY_PROXY_TEST_TIMEOUT_MS=25000
# RELAY_PROXY_PROBE_TIMEOUT_MS=20000
TIMEZONE=America/Toronto
LOCALE=en-US

# AWS S3 object storage (filings PDFs) — required for production
# AWS_S3_ENABLED=true
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=eu-north-1
# AWS_S3_BUCKET=orewire-filings
# AWS_S3_PUBLIC_BASE_URL=https://orewire-filings.s3.eu-north-1.amazonaws.com
# STORAGE_FILING_PREFIX=filings
# AWS_S3_UPLOAD_DELAY_MS=75
# Keep bucket private and use presigned URLs (recommended — lower risk, same egress cost as public):
# AWS_S3_PRESIGNED_URLS=true
# AWS_S3_PRESIGN_EXPIRES_SEC=3600
#
# pdf_path in DB uses s3:key (stable). GET /api/filings/:id/document returns a presigned redirect.
# Test S3: node scripts/test-aws-s3-connection.js
# Admin UI: /admin/storage.html

# Browser proxies — managed in Admin → Proxies (browser_proxies table).
# One-time seed from legacy .env: node scripts/seed-initial-proxies.js

# Ollama AI — managed in Admin → AI (ai_providers table).
# One-time seed from legacy .env: node scripts/seed-ollama-from-env.js

# News AI enrichment budget (Google News + RSS summaries)
# NEWS_ENRICH_ENABLED=true
# NEWS_ENRICH_MAX_AGE_HOURS=48
# NEWS_ENRICH_DAILY_MAX_CALLS=30
# NEWS_ENRICH_BATCH_SIZE=5
# NEWS_ENRICH_REQUIRE_COMPANY=true
# NEWS_ENRICH_MAX_DRAIN_BATCHES=2

# Usage event logs (AI + proxy) — retained 3 days by default
# USAGE_LOG_RETENTION_DAYS=3
# USAGE_LOG_PRUNE_CRON=15 4 * * *
# USAGE_LOG_PRUNE_ENABLED=false

# OreWire Relay — interactive browser pool (size = enabled proxies + 1 direct)
# RELAY_ENABLED=true
# RELAY_AUTO_START=1
# RELAY_HEADLESS=true   # use true in Docker/Dokploy (headed mode auto-disabled without DISPLAY)
# RELAY_VIEW_SECRET=generate_a_long_random_string
RELAY_BASE_URL=https://backend.orewire.com

# Admin Panel Password Protection
ADMIN_PASSWORD=your_admin_password

# Email (Resend) — verify no-reply@orewire.com in Resend dashboard
# AUTH_FROM_EMAIL: OTP, welcome, and Morning Brief subscribe confirmation
RESEND_API_KEY=your_resend_api_key
AUTH_FROM_EMAIL=OreWire <no-reply@orewire.com>
APP_URL=https://orewire.com
# Optional email link overrides
# EMAIL_FEED_URL=https://orewire.com/
# EMAIL_WATCHLIST_URL=https://orewire.com/watchlist
# EMAIL_PREFERENCES_URL=https://orewire.com/profile
# EMAIL_X_URL=https://x.com/Orewirenews
# EMAIL_LINKEDIN_URL=https://www.linkedin.com/company/orewire/
# EMAIL_INSTAGRAM_URL=https://www.instagram.com/orewirenews

# Daily morning briefing (Resend)
BRIEFING_FROM_EMAIL=OreWire Briefing <briefing@orewire.com>
BRIEFING_CRON=30 7 * * *
BRIEFING_TIMEZONE=America/Toronto
# BRIEFING_CRON_ENABLED=false
# BRIEFING_SEND_SECRET=your_secret_for_POST_api_briefing_send-now
# BRIEFING_SEND_DELAY_MS=200

# Watchlist news alerts (Resend) — one email per news item per watchlisted company
ALERTS_FROM_EMAIL=OreWire Alerts <alerts@orewire.com>
# WATCHLIST_NEWS_CRON=*/10 * * * *
# WATCHLIST_NEWS_CRON_ENABLED=false
# WATCHLIST_NEWS_SEND_DELAY_MS=150

# Watchlist filing alerts — morning batch (last 24h), from alerts@orewire.com
# WATCHLIST_FILING_CRON=35 7 * * *
# WATCHLIST_FILING_CRON_ENABLED=false
# WATCHLIST_FILING_LOOKBACK_HOURS=24
# WATCHLIST_FILING_SEND_DELAY_MS=200

# Home-page gainers/losers — free TradingView market scanner (server polls once;
# every browser reads /api/market/movers). Default: every minute.
# MOVERS_CRON=* * * * *
# MOVERS_CRON_ENABLED=false
# MOVERS_TIMEZONE=America/Toronto
# MOVERS_CACHE_TTL_MS=45000
# MOVERS_MIN_VOLUME=1000

# Web search for ticker research (Companies → Find new ticker / VA tab).
# Brave Search API is the reliable primary (not IP-gated). Get a free key at
# https://brave.com/search/api/ (free tier ~2k queries/month, 1 req/sec).
# Without it, the app falls back to the DuckDuckGo scraper (often blocked on
# datacenter IPs — routes through the residential proxy pool when available).
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# BRAVE_MIN_GAP_MS=1100
# DDG_MIN_GAP_MS=1200
# DDG_USE_PROXY=false

# Social Automation — daily X morning thread (Admin → Social Automation)
# Live posts use the official X API v2 (OAuth 1.0a). Get keys at developer.x.com
# with Read and Write app permissions, then generate user Access Token + Secret.
# Pay-per-use (2026): ~$0.015 per post, ~$0.20 if the post contains a link.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# Encrypts DB-stored API keys / legacy secrets (falls back to ADMIN_PASSWORD if unset)
# SOCIAL_SECRETS_KEY=generate_a_long_random_string
# SOCIAL_X_CRON=0 8 * * *
# SOCIAL_X_CRON_ENABLED=false
# SOCIAL_X_DRY_RUN=true
# Legacy WebBridge (unused for posting — kept for debugging only):
# SOCIAL_BRIDGE_URL=https://….ngrok-free.app
# SOCIAL_BRIDGE_TOKEN=
# WEBBRIDGE=1
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-name.ngrok-free.dev
# Legacy / override: residential HTTP proxy URL for X Browser (manual login viewer)
# SOCIAL_X_PROXY=http://user:pass@host:port

# Google OAuth (Continue with Google on login/signup)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# X Browser — password-gated Chromium embedded in the main server at /x-browser
# Always launches through a residential proxy (SOCIAL_X_PROXY or Admin → Proxies residential tier).
# X_BROWSER_PASSWORD=choose-a-strong-password
# Optional profile dir (default ~/.orewire-x-browser):
# X_BROWSER_PROFILE=
# Prefer X Browser for social posts (falls back to WebBridge):
# HOSTED_BROWSER_POST=1
# Only if you run a SEPARATE `npm run x-browser` process on another host:
# X_BROWSER_URL=https://x-browser.example.com
# X_BROWSER_TOKEN=
# X_BROWSER_EMBED=0
