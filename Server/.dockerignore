node_modules
npm-debug.log*
.env
.env.*
!.env.example
data/downloads/*
data/cookies/*
.git
.gitignore
*.md
deploy/
# ...except the sshd config the image actually installs (negation must come
# after the directory exclusion above).
!deploy/tunnel-sshd/

# Relay browser profiles — live session cookies. Baking these into the image
# would ship one machine's session to every container (and add ~230MB).
data/profiles/
# Runtime state; the /app/data volume supplies these at run time.
data/*.jsonl
data/jobs.json
data/seed-state.json
tmp/
